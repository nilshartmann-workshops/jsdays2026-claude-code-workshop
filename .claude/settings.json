{
  "model": "sonnet",
  "env": {
    "CLAUDE_CODE_DISABLE_FAST_MODE": "1"
  },
  "disableAutoMode": "disable",
  "permissions": {
    "allow": [
      "Bash(npm test *)",
      "Bash(npm run check *)",
      "Bash(npm run audit *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ]
  }
}
