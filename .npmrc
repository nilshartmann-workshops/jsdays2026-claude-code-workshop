# Eine Version wird erst installiert, wenn sie sieben Tage alt ist (Angabe in Tagen).
min-release-age=7

# Abhängigkeiten dürfen nicht aus Git-Repositories kommen.
allow-git=none

# Install-Skripte von Abhängigkeiten (postinstall und ähnliche) laufen nicht.
# Das Projekt lässt sich damit vollständig installieren, bauen und testen.
ignore-scripts=true
